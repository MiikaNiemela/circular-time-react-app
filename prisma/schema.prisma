// Prisma schema for Circular Time.
// This greenfield application creates its database schema directly from this file.
// Apply it to a freshly provisioned database with `npx prisma db push`.
// Use `npx prisma generate` after schema changes to regenerate the client.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String             @id @default(uuid())
  createdAt         DateTime           @default(now())
  accounts          ProviderAccount[]
  cachedEventRanges CachedEventRange[]
}

model ProviderAccount {
  id                String   @id @default(uuid())
  provider          String
  providerUserId    String
  userId            String
  calendarConnected Boolean  @default(false)
  createdAt         DateTime @default(now())
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@unique([userId, provider])
}

model CachedEventRange {
  id         String   @id @default(uuid())
  userId     String
  calendarId String
  rangeStart String
  rangeEnd   String
  fetchedAt  DateTime @default(now())
  eventsJson String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, calendarId, rangeStart, rangeEnd])
}
