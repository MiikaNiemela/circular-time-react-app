// Prisma schema for Circular Time.
// Apply migrations locally with `npx prisma migrate dev`.
// Apply committed migrations with `npx prisma migrate deploy`.
// Use `npx prisma generate` after schema changes to regenerate the client.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String               @id @default(uuid())
  createdAt           DateTime             @default(now())
  accounts            ProviderAccount[]
  calendarConnections CalendarConnection[]
  cachedEventRanges   CachedEventRange[]
  sessions            Session[]
  streams             Stream[]
}

// Server-side application sessions. The cookie carries an opaque random token;
// only its SHA-256 hash is stored, so a database copy cannot be replayed as a
// cookie. Deleting a row revokes that session immediately.
model Session {
  id        String   @id
  userId    String
  createdAt DateTime @default(now())
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// Provider identities used to create application sessions.
model ProviderAccount {
  id             String   @id @default(uuid())
  provider       String
  providerUserId String
  userId         String
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@unique([userId, provider])
}

// Calendar identities are separate from application sign-in identities.
model CalendarConnection {
  id                String             @id @default(uuid())
  provider          String
  providerUserId    String
  userId            String
  createdAt         DateTime           @default(now())
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  cachedEventRanges CachedEventRange[]
  credential        CalendarCredential?
  streamSources     StreamSource[]

  @@unique([provider, providerUserId])
  @@unique([userId, provider])
  @@unique([id, userId])
}

model CachedEventRange {
  id         String   @id @default(uuid())
  userId     String
  calendarId String
  rangeStart String
  rangeEnd   String
  fetchedAt  DateTime @default(now())
  eventsJson String

  user                 User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  calendarConnectionId String?
  calendarConnection   CalendarConnection? @relation(fields: [calendarConnectionId, userId], references: [id, userId], onDelete: Cascade)

  @@unique([userId, calendarId, rangeStart, rangeEnd])
  @@index([calendarConnectionId])
}

/// Provider OAuth tokens for one calendar connection, encrypted by the
/// application (AES-256-GCM) and bound to the owning user and connection.
/// Deleted with the connection, so disconnecting removes stored credentials.
model CalendarCredential {
  calendarConnectionId String             @id
  userId               String
  ciphertext           String
  updatedAt            DateTime           @updatedAt
  calendarConnection   CalendarConnection @relation(fields: [calendarConnectionId, userId], references: [id, userId], onDelete: Cascade)

  @@unique([calendarConnectionId, userId])
}

/// An ordered, named, toggleable ring on the timeline, fed by its sources.
/// `color` is a palette key resolved by the theme, never a CSS value.
/// `position` is dense per account: 0 is the outermost ring.
model Stream {
  id        String         @id @default(uuid())
  userId    String
  name      String
  color     String
  position  Int
  visible   Boolean        @default(true)
  createdAt DateTime       @default(now())
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  sources   StreamSource[]

  @@unique([id, userId])
  @@index([userId, position])
}

/// One input of a stream. `kind` names the source type; each kind has its
/// own reference column, tied to it by a CHECK constraint in the migration.
/// Both relations include `userId`, so a source cannot cross accounts, and a
/// calendar feeds at most one stream.
model StreamSource {
  id                   String              @id @default(uuid())
  userId               String
  streamId             String
  kind                 String
  calendarConnectionId String?             @unique
  stream               Stream              @relation(fields: [streamId, userId], references: [id, userId], onDelete: Cascade)
  calendarConnection   CalendarConnection? @relation(fields: [calendarConnectionId, userId], references: [id, userId], onDelete: Cascade)

  @@index([streamId])
}
