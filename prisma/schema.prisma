// Prisma schema for Circular Time.
// Apply migrations locally with `npx prisma migrate dev`.
// Apply committed migrations with `npx prisma migrate deploy`.
// Use `npx prisma generate` after schema changes to regenerate the client.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String               @id @default(uuid())
  createdAt           DateTime             @default(now())
  accounts            ProviderAccount[]
  calendarConnections CalendarConnection[]
  cachedEventRanges   CachedEventRange[]
}

// Provider identities used to create application sessions.
model ProviderAccount {
  id             String   @id @default(uuid())
  provider       String
  providerUserId String
  userId         String
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@unique([userId, provider])
}

// Calendar identities are separate from application sign-in identities.
model CalendarConnection {
  id                String             @id @default(uuid())
  provider          String
  providerUserId    String
  userId            String
  createdAt         DateTime           @default(now())
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  cachedEventRanges CachedEventRange[]

  @@unique([provider, providerUserId])
  @@unique([userId, provider])
  @@unique([id, userId])
}

model CachedEventRange {
  id         String   @id @default(uuid())
  userId     String
  calendarId String
  rangeStart String
  rangeEnd   String
  fetchedAt  DateTime @default(now())
  eventsJson String

  user                 User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  calendarConnectionId String?
  calendarConnection   CalendarConnection? @relation(fields: [calendarConnectionId, userId], references: [id, userId], onDelete: Cascade)

  @@unique([userId, calendarId, rangeStart, rangeEnd])
  @@index([calendarConnectionId])
}
