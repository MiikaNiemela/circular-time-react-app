{
  "name": "circular-time-react-app",
  "description": "Application showing different timelines in intuitive circular patterns.",
  "keywords": [],
  "license": "ISC",
  "private": true,
  "homepage": "https://github.com/MiikaNiemela/circular-time-react-app#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MiikaNiemela/circular-time-react-app.git"
  },
  "bugs": {
    "url": "https://github.com/MiikaNiemela/circular-time-react-app/issues"
  },
  "type": "module",
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build && vite build --config vite.jobs.config.ts",
    "refresh-calendars": "node build/jobs/refresh-calendars.js",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc --noEmit",
    "lint": "eslint app/ --max-warnings=0",
    "lint:md": "markdownlint-cli2",
    "format:check": "prettier --check app/",
    "format": "prettier --write app/",
    "test": "vitest",
    "test:db": "vitest run --project db",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "docker:build": "docker build -t circular-time-app .",
    "docker:serve": "npm run docker:build && docker run --rm -p 8080:8080 circular-time-app",
    "postinstall": "prisma generate"
  },
  "engines": {
    "node": "^22.22.2 || >=24.15.0"
  },
  "dependencies": {
    "@fontsource-variable/hanken-grotesk": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@google-cloud/secret-manager": "^6.2.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@react-router/node": "^7.18.4",
    "@react-router/serve": "^7.18.4",
    "@storybook/addon-mcp": "^10.6.5",
    "@vanilla-extract/css": "^1.21.3",
    "@vanilla-extract/vite-plugin": "^5.2.6",
    "isbot": "^5.2.2",
    "react": "^19.2.17",
    "react-dom": "^19.2.17",
    "react-router": "^7.18.4"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.4.0",
    "@eslint/js": "^10.0.1",
    "@react-router/dev": "^7.18.4",
    "@storybook/addon-a11y": "^10.6.5",
    "@storybook/addon-docs": "^10.6.5",
    "@storybook/addon-vitest": "^10.6.5",
    "@storybook/react-vite": "^10.6.5",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "latest",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "6.2.1",
    "@vitest/browser-playwright": "^5.1.0",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^65.0.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.1.1",
    "markdownlint-cli2": "^0.24.0",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "prisma": "^7.10.1",
    "storybook": "^10.6.5",
    "typescript": "^6",
    "typescript-eslint": "^8.71.0",
    "vite": "8.3.5",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "@prisma/engines@7.10.1": true,
    "fsevents@2.3.3": true,
    "prisma@7.10.1": true,
    "protobufjs@7.6.6": true
  }
}
