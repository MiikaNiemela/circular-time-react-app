{
  "name": "circular-time-react-app",
  "description": "Application showing different timelines in intuitive circular patterns.",
  "keywords": [],
  "license": "ISC",
  "private": true,
  "homepage": "https://github.com/MiikaNiemela/circular-time-react-app#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MiikaNiemela/circular-time-react-app.git"
  },
  "bugs": {
    "url": "https://github.com/MiikaNiemela/circular-time-react-app/issues"
  },
  "type": "module",
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc --noEmit",
    "lint": "eslint app/ --max-warnings=0",
    "lint:md": "markdownlint-cli2",
    "format:check": "prettier --check app/",
    "format": "prettier --write app/",
    "test": "vitest",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "docker:build": "docker build -t circular-time-app .",
    "docker:serve": "npm run docker:build && docker run --rm -p 8080:8080 circular-time-app",
    "postinstall": "prisma generate"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@google-cloud/secret-manager": "^6.2.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@react-router/node": "^7.18.4",
    "@react-router/serve": "^7.18.4",
    "@storybook/addon-mcp": "^10.6.1",
    "@vanilla-extract/css": "^1.21.2",
    "@vanilla-extract/vite-plugin": "^5.2.6",
    "isbot": "^5",
    "react": "^19.2.17",
    "react-dom": "^19.2.17",
    "react-router": "^7.18.4"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.4.0",
    "@react-router/dev": "^7.18.4",
    "@storybook/addon-a11y": "^10.6.1",
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/addon-vitest": "^10.6.1",
    "@storybook/react-vite": "^10.6.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "latest",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitest/browser-playwright": "^5.0.3",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^65.0.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.1.1",
    "markdownlint-cli2": "^0.23.3",
    "playwright": "^1.63.0",
    "prettier": "^3.9.9",
    "prisma": "^7.10.0",
    "storybook": "^10.6.1",
    "typescript": "^6",
    "typescript-eslint": "^8.71.0",
    "vite": "8.3.1",
    "vitest": "^5.0.3"
  }
}
